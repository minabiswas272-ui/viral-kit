# Environment configuration for ViralKit.
# Firebase AI Logic uses App Check attestation instead of a client-side GEMINI_API_KEY.

# Supabase Project URL (configure via AI Studio Secrets panel, e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=SUPABASE_URL_DEFAULT_VALUE

# Supabase Anon / Publishable Key (configure via AI Studio Secrets panel; never embed service_role key)
SUPABASE_ANON_KEY=SUPABASE_ANON_KEY_DEFAULT_VALUE
